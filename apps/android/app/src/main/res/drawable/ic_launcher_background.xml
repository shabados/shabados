<?xml version="1.0" encoding="utf-8"?>
<!-- Approximates the radial gradient in brand/assets/lotus.svg. Android shape
     gradients cannot reproduce the SVG's offset radial exactly; this is close
     enough that the foreground's own corners blend into it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:endColor="@color/brand_maroon"
        android:startColor="@color/brand_magenta"
        android:type="linear" />
</shape>
