# Gradle's local cache. Machine-specific, binary, and includes lock files.
.gradle/

# Absolute path to this machine's Android SDK. Regenerated by Android Studio on
# first open; committing it breaks the build for everyone else.
local.properties

# IDE state. Android Studio rewrites much of this on every open.
.idea/
*.iml
captures/

# Native build output; `build/` is already ignored at the repo root.
.cxx/

# Native libraries staged by `mise run android` in packages/gurmukhi. Build output
# for four ABIs, rebuilt from source; same reason that package ignores its own
# staged copies rather than committing them.
app/src/main/jniLibs/
