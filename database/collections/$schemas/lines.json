{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "A fundamental, abstract unit of content, backed by a consistent id.",
  "required": ["content"],
  "$defs": {
    "assets": {
      "description": "The assets that agree on this entry, verbatim. Always a list, even for one.",
      "type": "array",
      "items": { "$ref": "common.json#/$defs/Identifier" },
      "minItems": 1,
      "uniqueItems": true
    },
    "baseContent": {
      "type": "object",
      "required": ["assets", "type", "data"],
      "properties": {
        "type": { "type": "string" },
        "assets": { "$ref": "#/$defs/assets" },
        "data": { "type": "string" }
      }
    },
    "primaryContent": {
      "type": "object",
      "required": ["type", "assets", "data"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "primary" },
        "assets": { "$ref": "#/$defs/assets" },
        "data": { "type": "string" },
        "page": { "type": "integer" },
        "line": { "type": "integer" }
      }
    },
    "translationContent": {
      "type": "object",
      "required": ["type", "language", "assets", "data"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "translation" },
        "language": { "$ref": "common.json#/$defs/LanguageCode" },
        "assets": { "$ref": "#/$defs/assets" },
        "data": { "type": "string" }
      }
    },
    "noteContent": {
      "type": "object",
      "required": ["type", "language", "assets", "data"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "note" },
        "language": { "$ref": "common.json#/$defs/LanguageCode" },
        "assets": { "$ref": "#/$defs/assets" },
        "data": { "type": "string" }
      }
    },
    "pronunciationContent": {
      "type": "object",
      "required": ["type", "language", "assets", "data"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "pronunciation" },
        "language": { "$ref": "common.json#/$defs/LanguageCode" },
        "assets": { "$ref": "#/$defs/assets" },
        "data": { "type": "string" }
      }
    }
  },
  "properties": {
    "content": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/primaryContent" },
          { "$ref": "#/$defs/translationContent" },
          { "$ref": "#/$defs/noteContent" },
          { "$ref": "#/$defs/pronunciationContent" }
        ]
      }
    }
  },
  "additionalProperties": false
}
